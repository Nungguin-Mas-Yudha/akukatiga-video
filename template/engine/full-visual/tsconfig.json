{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["src", "registry.ts", "../../videos/*/composition", "../../videos/*/compositions", "../../videos/*/compositions/*"],
  "exclude": ["**/*.test.ts", "../../**/*.test.ts"]
}
